# Copy this file to ".env" and fill in your own values. Never put real secrets in this example file.

# Port the backend API listens on
PORT=4000

# PostgreSQL connection string
# Format: postgres://<user>:<password>@<host>:<port>/<database name>
# Replace "airvoice_dev_pw" with the password you set when installing PostgreSQL
DATABASE_URL=postgres://postgres:airvoice_dev_pw@localhost:5432/airvoice

# Secret used to sign login tokens (JWT). Replace with your own long random string
JWT_SECRET=change-me-to-a-long-random-string

# Mail server for OTP emails (Mailpit): address and SMTP port
SMTP_HOST=localhost
SMTP_PORT=1025

# "From" name and address on the OTP email
MAIL_FROM="AirVoice <no-reply@airvoice.local>"

# How long an OTP stays valid, in seconds (300 = 5 minutes)
OTP_TTL_SECONDS=300

# Fake UPI payee id placed in the payment QR code (mock, no real money moves)
UPI_PAYEE_ID=airvoice@demobank

# The only website allowed to call the API (CORS): the React app
CLIENT_ORIGIN=http://localhost:5173